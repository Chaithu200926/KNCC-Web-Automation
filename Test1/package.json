{
  "name": "test1",
  "version": "1.0.0",
  "description": "Playwright smoke tests for Cinescape Kuwait",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:uat": "playwright test -c playwright.uat.config.ts",
    "test:pre-uat": "playwright test -c playwright.pre-uat.config.ts",
    "report:uat": "playwright show-report playwright-report-uat",
    "report:pre-uat": "playwright show-report playwright-report-pre-uat",
    "report": "playwright show-report",
    "dashboard": "node scripts/generate-dashboard.js",
    "portal": "node team-portal/server.js",
    "site:uat": "powershell -ExecutionPolicy Bypass -File scripts/run-site.ps1 -Site uat",
    "site:pre-uat": "powershell -ExecutionPolicy Bypass -File scripts/run-site.ps1 -Site pre-uat",
    "site:both": "powershell -ExecutionPolicy Bypass -File scripts/run-site.ps1 -Site both"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "typescript": "^7.0.2"
  }
}
