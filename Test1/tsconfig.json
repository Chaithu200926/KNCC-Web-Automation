{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.uat.config.ts",
    "playwright.pre-uat.config.ts",
    "config/**/*.ts",
    "pages/**/*.ts",
    "tests/**/*.ts",
    "tests-uat/**/*.ts",
    "tests-pre-uat/**/*.ts",
    "reporters/**/*.ts"
  ]
}
